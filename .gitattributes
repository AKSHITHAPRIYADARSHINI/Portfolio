# Normalize line endings: store text files as LF in the repo,
# check out with LF on all platforms. Prevents CRLF/LF diff noise.
* text=auto eol=lf

# Explicit binary types (never touch these)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.mp4 binary
*.woff binary
*.woff2 binary
*.ttf binary
